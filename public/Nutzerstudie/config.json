        "Niederschlag_VSUP": {
            "type": "react-component",
            "path": "libraries/uncertainty_visualization/VSUP/VSUP.tsx",
            "parameters": {
                "preset": "precipitation",
                "output": "Vsup"
            },
            "instruction": "Beantworten Sie die folgenden Fragen:",
            "instructionLocation": "sidebar",
            "response": [
                {
                    "id": "Niederschlag_VSUP_Response",
                    "type": "radio",
                    "required": true,
                    "prompt": "Unsicherheit?",
                    "options": [
                        "1",
                        "2",
                        "3"
                    ],
                    "location": "sidebar"
                },
                {
                    "id": "Niederschlag_VSUP_checkbox",
                    "type": "checkbox",
                    "required": true,
                    "prompt": "Unsicherheit?",
                    "options": [
                        "1",
                        "2",
                        "3"
                    ],
                    "location": "sidebar"
                },
                {
                    "id": "Niederschlag_VSUP_Likert_Response",
                    "type": "likert",
                    "prompt": "Wie gut war für Sie die Unsicherheit zu erkennen?",
                    "numItems": 7,
                    "leftLabel": "Sehr schlecht",
                    "rightLabel": "Sehr gut",
                    "location": "sidebar"
                }
            ],
            "nextButtonLocation": "sidebar"
        },
        "Niederschlag_ScaledGlyph": {
            "type": "react-component",
