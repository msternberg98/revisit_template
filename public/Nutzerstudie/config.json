        "Demographic": {
            "type": "questionnaire",
            "response": [
                {
                    "id": "Qualification",
                    "prompt": "Welchen Schulabschluss haben Sie?",
                    "required": false,
                    "location": "aboveStimulus",
                    "type": "dropdown",
                    "placeholder": "Bitte geben Sie ihren Beruf an",
                    "options": ["Hauptschule", "Realschule", "Gymnasium", "Bachelor", "Master"]
                },
                {
                    "id": "Age",
                    "prompt": "Wie alt sind Sie?",
                    "required": false,
                    "location": "aboveStimulus",
                    "type": "dropdown",
                    "placeholder": "Bitte geben Sie ihr Alter an",
                    "options": ["18-22", "23-27", "28-32", "33-37", "38-42", "43-47", "48-52", "53-57", "58-62", "63-67", "68-72", "73-77", "78-82", "83+"]
                },
                {
                    "id": "Eyesight",
                    "prompt": "Haben Sie eine Farbsehschwäche?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "dropdown",
                    "placeholder": "Bitte geben Sie ihre Farbsehschwäche an",
                    "options": ["Deuteranopie (Grünblindheit)", "Protanopie (Rotblindheit)", "Tritanopie (Blaublindheit)", "Monochromasie", "Achromatopsie"]
                }
            ]
        },
        "Feedback": {
            "type": "questionnaire",
            "response": [
                {
                    "id": "Rating",
                    "prompt": "Bewerten Sie Ihre Zufriedenheit mit dieser Studie auf einer Skala von 1 (nicht zufrieden) bis 5 (sehr zufrieden).",
